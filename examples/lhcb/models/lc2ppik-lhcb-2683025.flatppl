%%%
# Λc+ → p π+ K− (LHCb, arXiv:2208.03262): amplitude model

Helicity amplitudes and published couplings. Masses are in GeV.
%%%
flatppl_compat = "0.1"
amp = load_module("../../../main.flatppl")
hep = standard_module("particle-physics", "0.1")
bw = load_module("../support/breitwigner.flatppl")
wd = load_module("../support/wigner.flatppl")

# ----------------------------------------------------------------------------
# Masses
# ----------------------------------------------------------------------------

m0 = 2.28646  % Lc
m1 = 0.938272046  % p
m2 = 0.13957018  % pi
m3 = 0.493677  % K
s0 = m0^2
ms1 = m1^2
ms2 = m2^2
ms3 = m3^2

# ----------------------------------------------------------------------------
# Lineshapes of the resonances, as functions of the mass squared s
# ----------------------------------------------------------------------------

% L1405_Flatte (MultichannelBreitWigner)
ls_L1405_Flatte(s) = amp.resonance_multichannel_breitwigner(s, 1.4051, [0.328725260215546, 0.328725260215546], [0.938272046, 1.18937], [0.493677, 0.13957018], [0, 0], [0.0, 0.0])
% L1520_BW (BreitWigner)
ls_L1520_BW(s) = bw.resonance_breitwigner(s, 1.518467, 0.015195, hep.breakup_momentum(sqrt(s), 0.493677, 0.938272046), hep.breakup_momentum(1.518467, 0.493677, 0.938272046), hep.blatt_weisskopf(2, hep.breakup_momentum(sqrt(s), 0.493677, 0.938272046), 1.5), hep.blatt_weisskopf(2, hep.breakup_momentum(1.518467, 0.493677, 0.938272046), 1.5))
% L1600_BW (BreitWigner)
ls_L1600_BW(s) = bw.resonance_breitwigner(s, 1.63, 0.25, hep.breakup_momentum(sqrt(s), 0.493677, 0.938272046), hep.breakup_momentum(1.63, 0.493677, 0.938272046), hep.blatt_weisskopf(1, hep.breakup_momentum(sqrt(s), 0.493677, 0.938272046), 1.5), hep.blatt_weisskopf(1, hep.breakup_momentum(1.63, 0.493677, 0.938272046), 1.5))
% L1670_BW (BreitWigner)
ls_L1670_BW(s) = bw.resonance_breitwigner(s, 1.67, 0.03, hep.breakup_momentum(sqrt(s), 0.493677, 0.938272046), hep.breakup_momentum(1.67, 0.493677, 0.938272046), hep.blatt_weisskopf(0, hep.breakup_momentum(sqrt(s), 0.493677, 0.938272046), 1.5), hep.blatt_weisskopf(0, hep.breakup_momentum(1.67, 0.493677, 0.938272046), 1.5))
% L1690_BW (BreitWigner)
ls_L1690_BW(s) = bw.resonance_breitwigner(s, 1.69, 0.07, hep.breakup_momentum(sqrt(s), 0.493677, 0.938272046), hep.breakup_momentum(1.69, 0.493677, 0.938272046), hep.blatt_weisskopf(2, hep.breakup_momentum(sqrt(s), 0.493677, 0.938272046), 1.5), hep.blatt_weisskopf(2, hep.breakup_momentum(1.69, 0.493677, 0.938272046), 1.5))
% L2000_BW (BreitWigner)
ls_L2000_BW(s) = bw.resonance_breitwigner(s, 1.98819, 0.17926, hep.breakup_momentum(sqrt(s), 0.493677, 0.938272046), hep.breakup_momentum(1.98819, 0.493677, 0.938272046), hep.blatt_weisskopf(0, hep.breakup_momentum(sqrt(s), 0.493677, 0.938272046), 1.5), hep.blatt_weisskopf(0, hep.breakup_momentum(1.98819, 0.493677, 0.938272046), 1.5))
% D1232_BW (BreitWigner)
ls_D1232_BW(s) = bw.resonance_breitwigner(s, 1.232, 0.117, hep.breakup_momentum(sqrt(s), 0.938272046, 0.13957018), hep.breakup_momentum(1.232, 0.938272046, 0.13957018), hep.blatt_weisskopf(1, hep.breakup_momentum(sqrt(s), 0.938272046, 0.13957018), 1.5), hep.blatt_weisskopf(1, hep.breakup_momentum(1.232, 0.938272046, 0.13957018), 1.5))
% D1600_BW (BreitWigner)
ls_D1600_BW(s) = bw.resonance_breitwigner(s, 1.64, 0.3, hep.breakup_momentum(sqrt(s), 0.938272046, 0.13957018), hep.breakup_momentum(1.64, 0.938272046, 0.13957018), hep.blatt_weisskopf(1, hep.breakup_momentum(sqrt(s), 0.938272046, 0.13957018), 1.5), hep.blatt_weisskopf(1, hep.breakup_momentum(1.64, 0.938272046, 0.13957018), 1.5))
% D1700_BW (BreitWigner)
ls_D1700_BW(s) = bw.resonance_breitwigner(s, 1.69, 0.38, hep.breakup_momentum(sqrt(s), 0.938272046, 0.13957018), hep.breakup_momentum(1.69, 0.938272046, 0.13957018), hep.blatt_weisskopf(2, hep.breakup_momentum(sqrt(s), 0.938272046, 0.13957018), 1.5), hep.blatt_weisskopf(2, hep.breakup_momentum(1.69, 0.938272046, 0.13957018), 1.5))
% K700_BuggBW (generic_function)
ls_K700_BuggBW(s) = amp.resonance_bugg_breitwigner(s, 0.824, 0.478, 0.23397706275638377, 0.941060)
% K892_BW (BreitWigner)
ls_K892_BW(s) = bw.resonance_breitwigner(s, 0.8955, 0.047299999999999995, hep.breakup_momentum(sqrt(s), 0.13957018, 0.493677), hep.breakup_momentum(0.8955, 0.13957018, 0.493677), hep.blatt_weisskopf(1, hep.breakup_momentum(sqrt(s), 0.13957018, 0.493677), 1.5), hep.blatt_weisskopf(1, hep.breakup_momentum(0.8955, 0.13957018, 0.493677), 1.5))
% K1430_BuggBW (generic_function)
ls_K1430_BuggBW(s) = amp.resonance_bugg_breitwigner(s, 1.375, 0.190, 0.23397706275638377, 0.020981)




# ----------------------------------------------------------------------------
# Invariants and helicity angles of the three chains
# ----------------------------------------------------------------------------

# The amplitude depends on the three pair-mass invariants.
sigma1 = elementof(posreals)  % m²(23)
sigma2 = elementof(posreals)  % m²(31)
sigma3 = elementof(posreals)  % m²(12)
cos_theta1 = amp.dalitz_cos_theta(1, [sigma1, sigma2, sigma3], m0, [m1, m2, m3])  % chain (23)1
q1 = hep.breakup_momentum(m0, sqrt(sigma1), m1)  % momentum of 1 in the parent frame
p1 = hep.breakup_momentum(sqrt(sigma1), m2, m3)  % momentum in the (23) frame
cos_theta2 = amp.dalitz_cos_theta(2, [sigma1, sigma2, sigma3], m0, [m1, m2, m3])  % chain (31)2
q2 = hep.breakup_momentum(m0, sqrt(sigma2), m2)  % momentum of 2 in the parent frame
p2 = hep.breakup_momentum(sqrt(sigma2), m3, m1)  % momentum in the (31) frame
cos_theta3 = amp.dalitz_cos_theta(3, [sigma1, sigma2, sigma3], m0, [m1, m2, m3])  % chain (12)3
q3 = hep.breakup_momentum(m0, sqrt(sigma3), m3)  % momentum of 3 in the parent frame
p3 = hep.breakup_momentum(sqrt(sigma3), m1, m2)  % momentum in the (12) frame

# ----------------------------------------------------------------------------
# Decay chains: weight × sqrt(2J+1) × lineshape × form factors
# ----------------------------------------------------------------------------

% c01_L1405: L1405_Flatte, J = 1/2, chain (31)2, production: helicity coupling, 2λ = (1, 0), decay: parity coupling, 2λ = ±(0, 1), η = +
c01_L1405 = (7.38649400481717 + 1.971018433257411 * im) * sqrt(2.0) * ls_L1405_Flatte(sigma2)
% c02_L1405: L1405_Flatte, J = 1/2, chain (31)2, production: helicity coupling, 2λ = (-1, 0), decay: parity coupling, 2λ = ±(0, 1), η = +
c02_L1405 = (-3.2332358574805515 + 2.2557724553615772 * im) * sqrt(2.0) * ls_L1405_Flatte(sigma2)
% c03_L1520: L1520_BW, J = 3/2, chain (31)2, production: helicity coupling, 2λ = (-1, 0), decay: parity coupling, 2λ = ±(0, 1), η = -
c03_L1520 = (3.605175244894445 + 0.5435267843818713 * im) * sqrt(4.0) * ls_L1520_BW(sigma2) * hep.blatt_weisskopf(1, q2, 5.0) * hep.blatt_weisskopf(2, p2, 1.5)
% c04_L1520: L1520_BW, J = 3/2, chain (31)2, production: helicity coupling, 2λ = (1, 0), decay: parity coupling, 2λ = ±(0, 1), η = -
c04_L1520 = (-1.9704378756874323 + 18.379565942050206 * im) * sqrt(4.0) * ls_L1520_BW(sigma2) * hep.blatt_weisskopf(1, q2, 5.0) * hep.blatt_weisskopf(2, p2, 1.5)
% c05_L1600: L1600_BW, J = 1/2, chain (31)2, production: helicity coupling, 2λ = (1, 0), decay: parity coupling, 2λ = ±(0, 1), η = -
c05_L1600 = (10.062771632071723 - 1.2160303664881582 * im) * sqrt(2.0) * ls_L1600_BW(sigma2) * hep.blatt_weisskopf(1, p2, 1.5)
% c06_L1600: L1600_BW, J = 1/2, chain (31)2, production: helicity coupling, 2λ = (-1, 0), decay: parity coupling, 2λ = ±(0, 1), η = -
c06_L1600 = (-6.987335732146143 - 4.449911731331869 * im) * sqrt(2.0) * ls_L1600_BW(sigma2) * hep.blatt_weisskopf(1, p2, 1.5)
% c07_L1670: L1670_BW, J = 1/2, chain (31)2, production: helicity coupling, 2λ = (-1, 0), decay: parity coupling, 2λ = ±(0, 1), η = +
c07_L1670 = (-0.24012285628923374 - 0.10230279488850731 * im) * sqrt(2.0) * ls_L1670_BW(sigma2)
% c08_L1670: L1670_BW, J = 1/2, chain (31)2, production: helicity coupling, 2λ = (1, 0), decay: parity coupling, 2λ = ±(0, 1), η = +
c08_L1670 = (-0.40374241570833247 + 0.7154739757283278 * im) * sqrt(2.0) * ls_L1670_BW(sigma2)
% c09_L1690: L1690_BW, J = 3/2, chain (31)2, production: helicity coupling, 2λ = (-1, 0), decay: parity coupling, 2λ = ±(0, 1), η = -
c09_L1690 = (-1.5899154261176556 - 0.4543210160355851 * im) * sqrt(4.0) * ls_L1690_BW(sigma2) * hep.blatt_weisskopf(1, q2, 5.0) * hep.blatt_weisskopf(2, p2, 1.5)
% c10_L1690: L1690_BW, J = 3/2, chain (31)2, production: helicity coupling, 2λ = (1, 0), decay: parity coupling, 2λ = ±(0, 1), η = -
c10_L1690 = (-11.25382439169629 - 1.4573757648967332 * im) * sqrt(4.0) * ls_L1690_BW(sigma2) * hep.blatt_weisskopf(1, q2, 5.0) * hep.blatt_weisskopf(2, p2, 1.5)
% c11_L2000: L2000_BW, J = 1/2, chain (31)2, production: helicity coupling, 2λ = (1, 0), decay: parity coupling, 2λ = ±(0, 1), η = +
c11_L2000 = (-3.0661953154540726 - 2.684313105886122 * im) * sqrt(2.0) * ls_L2000_BW(sigma2)
% c12_L2000: L2000_BW, J = 1/2, chain (31)2, production: helicity coupling, 2λ = (-1, 0), decay: parity coupling, 2λ = ±(0, 1), η = +
c12_L2000 = (-5.667359734940468 - 5.38391527459506 * im) * sqrt(2.0) * ls_L2000_BW(sigma2)
% c13_D1232: D1232_BW, J = 3/2, chain (12)3, production: helicity coupling, 2λ = (-1, 0), decay: parity coupling, 2λ = ±(1, 0), η = +
c13_D1232 = (-10.91657692017265 + 4.915067165836356 * im) * sqrt(4.0) * ls_D1232_BW(sigma3) * hep.blatt_weisskopf(1, q3, 5.0) * hep.blatt_weisskopf(1, p3, 1.5)
% c14_D1232: D1232_BW, J = 3/2, chain (12)3, production: helicity coupling, 2λ = (1, 0), decay: parity coupling, 2λ = ±(1, 0), η = +
c14_D1232 = (-20.916449737345527 + 7.29308576054982 * im) * sqrt(4.0) * ls_D1232_BW(sigma3) * hep.blatt_weisskopf(1, q3, 5.0) * hep.blatt_weisskopf(1, p3, 1.5)
% c15_D1600: D1600_BW, J = 3/2, chain (12)3, production: helicity coupling, 2λ = (-1, 0), decay: parity coupling, 2λ = ±(1, 0), η = +
c15_D1600 = (10.394484212696474 - 2.8494349466419946 * im) * sqrt(4.0) * ls_D1600_BW(sigma3) * hep.blatt_weisskopf(1, q3, 5.0) * hep.blatt_weisskopf(1, p3, 1.5)
% c16_D1600: D1600_BW, J = 3/2, chain (12)3, production: helicity coupling, 2λ = (1, 0), decay: parity coupling, 2λ = ±(1, 0), η = +
c16_D1600 = (6.134820509903093 - 0.9138426164937006 * im) * sqrt(4.0) * ls_D1600_BW(sigma3) * hep.blatt_weisskopf(1, q3, 5.0) * hep.blatt_weisskopf(1, p3, 1.5)
% c17_D1700: D1700_BW, J = 3/2, chain (12)3, production: helicity coupling, 2λ = (-1, 0), decay: parity coupling, 2λ = ±(1, 0), η = -
c17_D1700 = (-29.25264941105087 - 4.044389587266232 * im) * sqrt(4.0) * ls_D1700_BW(sigma3) * hep.blatt_weisskopf(1, q3, 5.0) * hep.blatt_weisskopf(2, p3, 1.5)
% c18_D1700: D1700_BW, J = 3/2, chain (12)3, production: helicity coupling, 2λ = (1, 0), decay: parity coupling, 2λ = ±(1, 0), η = -
c18_D1700 = (-36.28747656529877 - 5.93484672030687 * im) * sqrt(4.0) * ls_D1700_BW(sigma3) * hep.blatt_weisskopf(1, q3, 5.0) * hep.blatt_weisskopf(2, p3, 1.5)
% c19_K700: K700_BuggBW, J = 0, chain (23)1, production: helicity coupling, 2λ = (0, 1), decay: parity coupling, 2λ = ±(0, 0), η = +
c19_K700 = (0.068908 + 2.521444 * im) * sqrt(1.0) * ls_K700_BuggBW(sigma1)
% c20_K700: K700_BuggBW, J = 0, chain (23)1, production: helicity coupling, 2λ = (0, -1), decay: parity coupling, 2λ = ±(0, 0), η = +
c20_K700 = (-2.68563 + 0.03849 * im) * sqrt(1.0) * ls_K700_BuggBW(sigma1)
% c21_K892: K892_BW, J = 1, chain (23)1, production: helicity coupling, 2λ = (-2, -1), decay: parity coupling, 2λ = ±(0, 0), η = +
c21_K892 = (1.7222349176997693 - 1.481361689419436 * im) * sqrt(3.0) * ls_K892_BW(sigma1) * hep.blatt_weisskopf(1, p1, 1.5)
% c22_K892: K892_BW, J = 1, chain (23)1, production: helicity coupling, 2λ = (0, 1), decay: parity coupling, 2λ = ±(0, 0), η = +
c22_K892 = (-1.0500585346397064 - 6.000208435743097 * im) * sqrt(3.0) * ls_K892_BW(sigma1) * hep.blatt_weisskopf(1, p1, 1.5)
% c23_K892: K892_BW, J = 1, chain (23)1, production: helicity coupling, 2λ = (0, -1), decay: parity coupling, 2λ = ±(0, 0), η = +
c23_K892 = 1.4440841024000803 * sqrt(3.0) * ls_K892_BW(sigma1) * hep.blatt_weisskopf(1, p1, 1.5)
% c24_K892: K892_BW, J = 1, chain (23)1, production: helicity coupling, 2λ = (2, 1), decay: parity coupling, 2λ = ±(0, 0), η = +
c24_K892 = (-4.536512227148323 - 4.755961023685448 * im) * sqrt(3.0) * ls_K892_BW(sigma1) * hep.blatt_weisskopf(1, p1, 1.5)
% c25_K1430: K1430_BuggBW, J = 0, chain (23)1, production: helicity coupling, 2λ = (0, 1), decay: parity coupling, 2λ = ±(0, 0), η = +
c25_K1430 = (-6.71516 + 10.479411 * im) * sqrt(1.0) * ls_K1430_BuggBW(sigma1)
% c26_K1430: K1430_BuggBW, J = 0, chain (23)1, production: helicity coupling, 2λ = (0, -1), decay: parity coupling, 2λ = ±(0, 0), η = +
c26_K1430 = (0.219754 + 8.741196 * im) * sqrt(1.0) * ls_K1430_BuggBW(sigma1)

# ----------------------------------------------------------------------------
# Wigner d-functions of the helicity angles
# ----------------------------------------------------------------------------

d1_0_0_0 = wd.wignerd_doublearg(0, 0, 0, cos_theta1)
d1_2_0_0 = wd.wignerd_doublearg(2, 0, 0, cos_theta1)
d1_2_m2_0 = wd.wignerd_doublearg(2, -2, 0, cos_theta1)
d1_2_p2_0 = wd.wignerd_doublearg(2, 2, 0, cos_theta1)
d2_1_m1_m1 = wd.wignerd_doublearg(1, -1, -1, cos_theta2)
d2_1_m1_p1 = wd.wignerd_doublearg(1, -1, 1, cos_theta2)
d2_1_p1_m1 = wd.wignerd_doublearg(1, 1, -1, cos_theta2)
d2_1_p1_p1 = wd.wignerd_doublearg(1, 1, 1, cos_theta2)
d2_3_m1_m1 = wd.wignerd_doublearg(3, -1, -1, cos_theta2)
d2_3_m1_p1 = wd.wignerd_doublearg(3, -1, 1, cos_theta2)
d2_3_p1_m1 = wd.wignerd_doublearg(3, 1, -1, cos_theta2)
d2_3_p1_p1 = wd.wignerd_doublearg(3, 1, 1, cos_theta2)
d3_3_m1_m1 = wd.wignerd_doublearg(3, -1, -1, cos_theta3)
d3_3_m1_p1 = wd.wignerd_doublearg(3, -1, 1, cos_theta3)
d3_3_p1_m1 = wd.wignerd_doublearg(3, 1, -1, cos_theta3)
d3_3_p1_p1 = wd.wignerd_doublearg(3, 1, 1, cos_theta3)

# ----------------------------------------------------------------------------
# Amplitudes of each chain group in its own frames
# ----------------------------------------------------------------------------

% A<k>_<particle>_<2λ>...: chains with spectator k, p1 = +1/2, m1 = -1/2, p2 = +1, ...
A1_p_m1_Lc_m1 = -1.0 * c21_K892 * d1_2_m2_0
A1_p_m1_Lc_p1 = (
    -1.0 * c20_K700 * d1_0_0_0
    - 1.0 * c23_K892 * d1_2_0_0
    - 1.0 * c26_K1430 * d1_0_0_0
)
A1_p_p1_Lc_m1 = (
    1.0 * c19_K700 * d1_0_0_0
    + 1.0 * c22_K892 * d1_2_0_0
    + 1.0 * c25_K1430 * d1_0_0_0
)
A1_p_p1_Lc_p1 = 1.0 * c24_K892 * d1_2_p2_0
A2_p_m1_Lc_m1 = (
    -1.0 * c02_L1405 * d2_1_m1_p1
    + 1.0 * c03_L1520 * d2_3_m1_p1
    + 1.0 * c06_L1600 * d2_1_m1_p1
    - 1.0 * c07_L1670 * d2_1_m1_p1
    + 1.0 * c09_L1690 * d2_3_m1_p1
    - 1.0 * c12_L2000 * d2_1_m1_p1
)
A2_p_m1_Lc_p1 = (
    -1.0 * c01_L1405 * d2_1_p1_p1
    + 1.0 * c04_L1520 * d2_3_p1_p1
    + 1.0 * c05_L1600 * d2_1_p1_p1
    - 1.0 * c08_L1670 * d2_1_p1_p1
    + 1.0 * c10_L1690 * d2_3_p1_p1
    - 1.0 * c11_L2000 * d2_1_p1_p1
)
A2_p_p1_Lc_m1 = (
    1.0 * c02_L1405 * d2_1_m1_m1
    + 1.0 * c03_L1520 * d2_3_m1_m1
    + 1.0 * c06_L1600 * d2_1_m1_m1
    + 1.0 * c07_L1670 * d2_1_m1_m1
    + 1.0 * c09_L1690 * d2_3_m1_m1
    + 1.0 * c12_L2000 * d2_1_m1_m1
)
A2_p_p1_Lc_p1 = (
    1.0 * c01_L1405 * d2_1_p1_m1
    + 1.0 * c04_L1520 * d2_3_p1_m1
    + 1.0 * c05_L1600 * d2_1_p1_m1
    + 1.0 * c08_L1670 * d2_1_p1_m1
    + 1.0 * c10_L1690 * d2_3_p1_m1
    + 1.0 * c11_L2000 * d2_1_p1_m1
)
A3_p_m1_Lc_m1 = (
    1.0 * c13_D1232 * d3_3_m1_m1
    + 1.0 * c15_D1600 * d3_3_m1_m1
    - 1.0 * c17_D1700 * d3_3_m1_m1
)
A3_p_m1_Lc_p1 = (
    1.0 * c14_D1232 * d3_3_p1_m1
    + 1.0 * c16_D1600 * d3_3_p1_m1
    - 1.0 * c18_D1700 * d3_3_p1_m1
)
A3_p_p1_Lc_m1 = (
    1.0 * c13_D1232 * d3_3_m1_p1
    + 1.0 * c15_D1600 * d3_3_m1_p1
    + 1.0 * c17_D1700 * d3_3_m1_p1
)
A3_p_p1_Lc_p1 = (
    1.0 * c14_D1232 * d3_3_p1_p1
    + 1.0 * c16_D1600 * d3_3_p1_p1
    + 1.0 * c18_D1700 * d3_3_p1_p1
)

# ----------------------------------------------------------------------------
# Alignment of the spins to the frames of the reference chain 2
# ----------------------------------------------------------------------------

# A particle with spin is rotated by its Wigner angle ζ between the frames of
# chain k and the reference chain (THREEBODYDECAYS, ThreeBodyDecays.jl).
cos_zeta1_p = amp.dalitz_cos_zeta(1, 1, 2, [sigma1, sigma2, sigma3], m0, [m1, m2, m3])
dz1_p_m1_m1 = wd.wignerd_doublearg(1, -1, -1, cos_zeta1_p)
dz1_p_m1_p1 = wd.wignerd_doublearg(1, -1, 1, cos_zeta1_p)
dz1_p_p1_m1 = wd.wignerd_doublearg(1, 1, -1, cos_zeta1_p)
dz1_p_p1_p1 = wd.wignerd_doublearg(1, 1, 1, cos_zeta1_p)
cos_zeta2_Lc = amp.dalitz_cos_zeta(0, 2, 1, [sigma1, sigma2, sigma3], m0, [m1, m2, m3])
dz2_Lc_m1_m1 = wd.wignerd_doublearg(1, -1, -1, cos_zeta2_Lc)
dz2_Lc_m1_p1 = wd.wignerd_doublearg(1, -1, 1, cos_zeta2_Lc)
dz2_Lc_p1_m1 = wd.wignerd_doublearg(1, 1, -1, cos_zeta2_Lc)
dz2_Lc_p1_p1 = wd.wignerd_doublearg(1, 1, 1, cos_zeta2_Lc)
cos_zeta3_p = amp.dalitz_cos_zeta(1, 3, 2, [sigma1, sigma2, sigma3], m0, [m1, m2, m3])
dz3_p_m1_m1 = wd.wignerd_doublearg(1, -1, -1, cos_zeta3_p)
dz3_p_m1_p1 = wd.wignerd_doublearg(1, -1, 1, cos_zeta3_p)
dz3_p_p1_m1 = wd.wignerd_doublearg(1, 1, -1, cos_zeta3_p)
dz3_p_p1_p1 = wd.wignerd_doublearg(1, 1, 1, cos_zeta3_p)
cos_zeta3_Lc = amp.dalitz_cos_zeta(0, 3, 1, [sigma1, sigma2, sigma3], m0, [m1, m2, m3])
dz3_Lc_m1_m1 = wd.wignerd_doublearg(1, -1, -1, cos_zeta3_Lc)
dz3_Lc_m1_p1 = wd.wignerd_doublearg(1, -1, 1, cos_zeta3_Lc)
dz3_Lc_p1_m1 = wd.wignerd_doublearg(1, 1, -1, cos_zeta3_Lc)
dz3_Lc_p1_p1 = wd.wignerd_doublearg(1, 1, 1, cos_zeta3_Lc)

# ----------------------------------------------------------------------------
# Amplitudes in the frames of the reference chain and the intensity
# ----------------------------------------------------------------------------

A_p_m1_Lc_m1 = (
    dz1_p_m1_m1 * A1_p_m1_Lc_m1
    - dz1_p_p1_m1 * A1_p_p1_Lc_m1
    + dz2_Lc_m1_m1 * A2_p_m1_Lc_m1
    - dz2_Lc_m1_p1 * A2_p_m1_Lc_p1
    + dz3_p_m1_m1 * dz3_Lc_m1_m1 * A3_p_m1_Lc_m1
    + dz3_p_m1_m1 * dz3_Lc_m1_p1 * A3_p_m1_Lc_p1
    - dz3_p_p1_m1 * dz3_Lc_m1_m1 * A3_p_p1_Lc_m1
    - dz3_p_p1_m1 * dz3_Lc_m1_p1 * A3_p_p1_Lc_p1
)
A_p_m1_Lc_p1 = (
    dz1_p_m1_m1 * A1_p_m1_Lc_p1
    - dz1_p_p1_m1 * A1_p_p1_Lc_p1
    - dz2_Lc_p1_m1 * A2_p_m1_Lc_m1
    + dz2_Lc_p1_p1 * A2_p_m1_Lc_p1
    + dz3_p_m1_m1 * dz3_Lc_p1_m1 * A3_p_m1_Lc_m1
    + dz3_p_m1_m1 * dz3_Lc_p1_p1 * A3_p_m1_Lc_p1
    - dz3_p_p1_m1 * dz3_Lc_p1_m1 * A3_p_p1_Lc_m1
    - dz3_p_p1_m1 * dz3_Lc_p1_p1 * A3_p_p1_Lc_p1
)
A_p_p1_Lc_m1 = (
    -dz1_p_m1_p1 * A1_p_m1_Lc_m1
    + dz1_p_p1_p1 * A1_p_p1_Lc_m1
    + dz2_Lc_m1_m1 * A2_p_p1_Lc_m1
    - dz2_Lc_m1_p1 * A2_p_p1_Lc_p1
    - dz3_p_m1_p1 * dz3_Lc_m1_m1 * A3_p_m1_Lc_m1
    - dz3_p_m1_p1 * dz3_Lc_m1_p1 * A3_p_m1_Lc_p1
    + dz3_p_p1_p1 * dz3_Lc_m1_m1 * A3_p_p1_Lc_m1
    + dz3_p_p1_p1 * dz3_Lc_m1_p1 * A3_p_p1_Lc_p1
)
A_p_p1_Lc_p1 = (
    -dz1_p_m1_p1 * A1_p_m1_Lc_p1
    + dz1_p_p1_p1 * A1_p_p1_Lc_p1
    - dz2_Lc_p1_m1 * A2_p_p1_Lc_m1
    + dz2_Lc_p1_p1 * A2_p_p1_Lc_p1
    - dz3_p_m1_p1 * dz3_Lc_p1_m1 * A3_p_m1_Lc_m1
    - dz3_p_m1_p1 * dz3_Lc_p1_p1 * A3_p_m1_Lc_p1
    + dz3_p_p1_p1 * dz3_Lc_p1_m1 * A3_p_p1_Lc_m1
    + dz3_p_p1_p1 * dz3_Lc_p1_p1 * A3_p_p1_Lc_p1
)

intensity = (
    abs2(A_p_m1_Lc_m1)
    + abs2(A_p_m1_Lc_p1)
    + abs2(A_p_p1_Lc_m1)
    + abs2(A_p_p1_Lc_p1)
)

% The intensity as a function of the invariants
intensity_of_sigmas = functionof(intensity, sigma1, sigma2, sigma3)
amplitudes_of_sigmas = functionof(record(A_p_m1_Lc_m1 = A_p_m1_Lc_m1, A_p_m1_Lc_p1 = A_p_m1_Lc_p1, A_p_p1_Lc_m1 = A_p_p1_Lc_m1, A_p_p1_Lc_p1 = A_p_p1_Lc_p1), sigma1, sigma2, sigma3)
