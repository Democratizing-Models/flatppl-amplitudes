%%%
# Λb0 → p K− γ (LHCb, arXiv:2403.03710): amplitude model

Helicity amplitudes and published couplings. Masses are in GeV.
%%%
flatppl_compat = "0.1"
amp = load_module("../../../main.flatppl")
hep = standard_module("particle-physics", "0.1")
bw = load_module("../support/breitwigner.flatppl")
wd = load_module("../support/wigner.flatppl")

# ----------------------------------------------------------------------------
# Masses
# ----------------------------------------------------------------------------

m0 = 5.62  % Lb
m1 = 0.938  % p
m2 = 0.493  % K
m3 = 0.0  % g
s0 = m0^2
ms1 = m1^2
ms2 = m2^2
ms3 = m3^2

# ----------------------------------------------------------------------------
# Lineshapes of the resonances, as functions of the mass squared s
# ----------------------------------------------------------------------------

% L1405_Flatte (MultichannelBreitWigner)
ls_L1405_Flatte(s) = amp.resonance_multichannel_breitwigner(s, 1.405, [0.3504277764790773, 0.3504277764790773], [0.938, 1.197], [0.493, 0.14], [0, 0], [0.0, 0.0])
% L1520_BW (BreitWigner)
ls_L1520_BW(s) = bw.resonance_breitwigner(s, 1.519, 0.016, hep.breakup_momentum(sqrt(s), 0.938, 0.493), hep.breakup_momentum(1.519, 0.938, 0.493), hep.blatt_weisskopf(2, hep.breakup_momentum(sqrt(s), 0.938, 0.493), 1.5), hep.blatt_weisskopf(2, hep.breakup_momentum(1.519, 0.938, 0.493), 1.5))
% L1600_BW (BreitWigner)
ls_L1600_BW(s) = bw.resonance_breitwigner(s, 1.6, 0.2, hep.breakup_momentum(sqrt(s), 0.938, 0.493), hep.breakup_momentum(1.6, 0.938, 0.493), hep.blatt_weisskopf(1, hep.breakup_momentum(sqrt(s), 0.938, 0.493), 1.5), hep.blatt_weisskopf(1, hep.breakup_momentum(1.6, 0.938, 0.493), 1.5))
% L1680_BW (BreitWigner)
ls_L1680_BW(s) = bw.resonance_breitwigner(s, 1.674, 0.03, hep.breakup_momentum(sqrt(s), 0.938, 0.493), hep.breakup_momentum(1.674, 0.938, 0.493), hep.blatt_weisskopf(0, hep.breakup_momentum(sqrt(s), 0.938, 0.493), 1.5), hep.blatt_weisskopf(0, hep.breakup_momentum(1.674, 0.938, 0.493), 1.5))
% L1690_BW (BreitWigner)
ls_L1690_BW(s) = bw.resonance_breitwigner(s, 1.69, 0.07, hep.breakup_momentum(sqrt(s), 0.938, 0.493), hep.breakup_momentum(1.69, 0.938, 0.493), hep.blatt_weisskopf(2, hep.breakup_momentum(sqrt(s), 0.938, 0.493), 1.5), hep.blatt_weisskopf(2, hep.breakup_momentum(1.69, 0.938, 0.493), 1.5))
% L1800_BW (BreitWigner)
ls_L1800_BW(s) = bw.resonance_breitwigner(s, 1.8, 0.2, hep.breakup_momentum(sqrt(s), 0.938, 0.493), hep.breakup_momentum(1.8, 0.938, 0.493), hep.blatt_weisskopf(0, hep.breakup_momentum(sqrt(s), 0.938, 0.493), 1.5), hep.blatt_weisskopf(0, hep.breakup_momentum(1.8, 0.938, 0.493), 1.5))
% L1810_BW (BreitWigner)
ls_L1810_BW(s) = bw.resonance_breitwigner(s, 1.79, 0.11, hep.breakup_momentum(sqrt(s), 0.938, 0.493), hep.breakup_momentum(1.79, 0.938, 0.493), hep.blatt_weisskopf(1, hep.breakup_momentum(sqrt(s), 0.938, 0.493), 1.5), hep.blatt_weisskopf(1, hep.breakup_momentum(1.79, 0.938, 0.493), 1.5))
% L1820_BW (BreitWigner)
ls_L1820_BW(s) = bw.resonance_breitwigner(s, 1.82, 0.08, hep.breakup_momentum(sqrt(s), 0.938, 0.493), hep.breakup_momentum(1.82, 0.938, 0.493), hep.blatt_weisskopf(3, hep.breakup_momentum(sqrt(s), 0.938, 0.493), 1.5), hep.blatt_weisskopf(3, hep.breakup_momentum(1.82, 0.938, 0.493), 1.5))
% L1830_BW (BreitWigner)
ls_L1830_BW(s) = bw.resonance_breitwigner(s, 1.825, 0.09, hep.breakup_momentum(sqrt(s), 0.938, 0.493), hep.breakup_momentum(1.825, 0.938, 0.493), hep.blatt_weisskopf(2, hep.breakup_momentum(sqrt(s), 0.938, 0.493), 1.5), hep.blatt_weisskopf(2, hep.breakup_momentum(1.825, 0.938, 0.493), 1.5))
% L1890_BW (BreitWigner)
ls_L1890_BW(s) = bw.resonance_breitwigner(s, 1.89, 0.12, hep.breakup_momentum(sqrt(s), 0.938, 0.493), hep.breakup_momentum(1.89, 0.938, 0.493), hep.blatt_weisskopf(1, hep.breakup_momentum(sqrt(s), 0.938, 0.493), 1.5), hep.blatt_weisskopf(1, hep.breakup_momentum(1.89, 0.938, 0.493), 1.5))
% L2100_BW (BreitWigner)
ls_L2100_BW(s) = bw.resonance_breitwigner(s, 2.1, 0.2, hep.breakup_momentum(sqrt(s), 0.938, 0.493), hep.breakup_momentum(2.1, 0.938, 0.493), hep.blatt_weisskopf(4, hep.breakup_momentum(sqrt(s), 0.938, 0.493), 1.5), hep.blatt_weisskopf(4, hep.breakup_momentum(2.1, 0.938, 0.493), 1.5))
% L2110_BW (BreitWigner)
ls_L2110_BW(s) = bw.resonance_breitwigner(s, 2.09, 0.25, hep.breakup_momentum(sqrt(s), 0.938, 0.493), hep.breakup_momentum(2.09, 0.938, 0.493), hep.blatt_weisskopf(3, hep.breakup_momentum(sqrt(s), 0.938, 0.493), 1.5), hep.blatt_weisskopf(3, hep.breakup_momentum(2.09, 0.938, 0.493), 1.5))
% L2350_BW (BreitWigner)
ls_L2350_BW(s) = bw.resonance_breitwigner(s, 2.35, 0.15, hep.breakup_momentum(sqrt(s), 0.938, 0.493), hep.breakup_momentum(2.35, 0.938, 0.493), hep.blatt_weisskopf(5, hep.breakup_momentum(sqrt(s), 0.938, 0.493), 1.5), hep.blatt_weisskopf(5, hep.breakup_momentum(2.35, 0.938, 0.493), 1.5))
% LNR30_NR (Polynomial)
ls_LNR30_NR(s) = polynomial(coefficients = [1.0], x = s)

