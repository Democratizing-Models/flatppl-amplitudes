    + ls_1_9_2_10_11_3_2 * ls_9_1_0_10_1_1_0 * c67_L2350 * d3_9_p3_p1
    + ls_1_9_2_12_11_3_2 * ls_9_1_0_10_1_1_0 * c68_L2350 * d3_9_p3_p1
    + ls_1_3_2_0_1_3_2 * ls_3_1_0_4_1_1_0 * c69_LNR3O * d3_3_p3_p1
    + ls_1_3_2_2_1_3_2 * ls_3_1_0_4_1_1_0 * c70_LNR3O * d3_3_p3_p1
    + ls_1_3_2_2_3_3_2 * ls_3_1_0_4_1_1_0 * c71_LNR3O * d3_3_p3_p1
    + ls_1_3_2_4_3_3_2 * ls_3_1_0_4_1_1_0 * c72_LNR3O * d3_3_p3_p1
    + ls_1_3_2_4_5_3_2 * ls_3_1_0_4_1_1_0 * c73_LNR3O * d3_3_p3_p1
    + ls_1_3_2_6_5_3_2 * ls_3_1_0_4_1_1_0 * c74_LNR3O * d3_3_p3_p1
)

# ----------------------------------------------------------------------------
# Alignment of the spins to the frames of the reference chain 3
# ----------------------------------------------------------------------------

# A particle with spin is rotated by its Wigner angle ζ between the frames of
# chain k and the reference chain (THREEBODYDECAYS, ThreeBodyDecays.jl).
cos_zeta3_Lb = amp.dalitz_cos_zeta(0, 3, 1, [sigma1, sigma2, sigma3], m0, [m1, m2, m3])
dz3_Lb_m1_m1 = wd.wignerd_doublearg(1, -1, -1, cos_zeta3_Lb)
dz3_Lb_m1_p1 = wd.wignerd_doublearg(1, -1, 1, cos_zeta3_Lb)
dz3_Lb_p1_m1 = wd.wignerd_doublearg(1, 1, -1, cos_zeta3_Lb)
dz3_Lb_p1_p1 = wd.wignerd_doublearg(1, 1, 1, cos_zeta3_Lb)

# ----------------------------------------------------------------------------
# Amplitudes in the frames of the reference chain and the intensity
# ----------------------------------------------------------------------------

A_p_m1_g_m2_Lb_m1 = (
    dz3_Lb_m1_m1 * A3_p_m1_g_m2_Lb_m1
    + dz3_Lb_m1_p1 * A3_p_m1_g_m2_Lb_p1
)
A_p_m1_g_m2_Lb_p1 = (
    dz3_Lb_p1_m1 * A3_p_m1_g_m2_Lb_m1
    + dz3_Lb_p1_p1 * A3_p_m1_g_m2_Lb_p1
)
A_p_m1_g_0_Lb_m1 = (
    dz3_Lb_m1_m1 * A3_p_m1_g_0_Lb_m1
    + dz3_Lb_m1_p1 * A3_p_m1_g_0_Lb_p1
)
A_p_m1_g_0_Lb_p1 = (
    dz3_Lb_p1_m1 * A3_p_m1_g_0_Lb_m1
    + dz3_Lb_p1_p1 * A3_p_m1_g_0_Lb_p1
)
A_p_m1_g_p2_Lb_m1 = (
    dz3_Lb_m1_m1 * A3_p_m1_g_p2_Lb_m1
    + dz3_Lb_m1_p1 * A3_p_m1_g_p2_Lb_p1
)
A_p_m1_g_p2_Lb_p1 = (
    dz3_Lb_p1_m1 * A3_p_m1_g_p2_Lb_m1
    + dz3_Lb_p1_p1 * A3_p_m1_g_p2_Lb_p1
)
A_p_p1_g_m2_Lb_m1 = (
    dz3_Lb_m1_m1 * A3_p_p1_g_m2_Lb_m1
    + dz3_Lb_m1_p1 * A3_p_p1_g_m2_Lb_p1
)
A_p_p1_g_m2_Lb_p1 = (
    dz3_Lb_p1_m1 * A3_p_p1_g_m2_Lb_m1
    + dz3_Lb_p1_p1 * A3_p_p1_g_m2_Lb_p1
)
A_p_p1_g_0_Lb_m1 = (
    dz3_Lb_m1_m1 * A3_p_p1_g_0_Lb_m1
    + dz3_Lb_m1_p1 * A3_p_p1_g_0_Lb_p1
)
A_p_p1_g_0_Lb_p1 = (
    dz3_Lb_p1_m1 * A3_p_p1_g_0_Lb_m1
    + dz3_Lb_p1_p1 * A3_p_p1_g_0_Lb_p1
)
A_p_p1_g_p2_Lb_m1 = (
    dz3_Lb_m1_m1 * A3_p_p1_g_p2_Lb_m1
    + dz3_Lb_m1_p1 * A3_p_p1_g_p2_Lb_p1
)
A_p_p1_g_p2_Lb_p1 = (
    dz3_Lb_p1_m1 * A3_p_p1_g_p2_Lb_m1
    + dz3_Lb_p1_p1 * A3_p_p1_g_p2_Lb_p1
)

intensity = (
    abs2(A_p_m1_g_m2_Lb_m1)
    + abs2(A_p_m1_g_m2_Lb_p1)
    + abs2(A_p_m1_g_0_Lb_m1)
    + abs2(A_p_m1_g_0_Lb_p1)
    + abs2(A_p_m1_g_p2_Lb_m1)
    + abs2(A_p_m1_g_p2_Lb_p1)
    + abs2(A_p_p1_g_m2_Lb_m1)
    + abs2(A_p_p1_g_m2_Lb_p1)
    + abs2(A_p_p1_g_0_Lb_m1)
    + abs2(A_p_p1_g_0_Lb_p1)
    + abs2(A_p_p1_g_p2_Lb_m1)
    + abs2(A_p_p1_g_p2_Lb_p1)
)

% The intensity as a function of the invariants
intensity_of_sigmas = functionof(intensity, sigma1, sigma2, sigma3)
amplitudes_of_sigmas = functionof(record(A_p_m1_g_m2_Lb_m1 = A_p_m1_g_m2_Lb_m1, A_p_m1_g_m2_Lb_p1 = A_p_m1_g_m2_Lb_p1, A_p_m1_g_0_Lb_m1 = A_p_m1_g_0_Lb_m1, A_p_m1_g_0_Lb_p1 = A_p_m1_g_0_Lb_p1, A_p_m1_g_p2_Lb_m1 = A_p_m1_g_p2_Lb_m1, A_p_m1_g_p2_Lb_p1 = A_p_m1_g_p2_Lb_p1, A_p_p1_g_m2_Lb_m1 = A_p_p1_g_m2_Lb_m1, A_p_p1_g_m2_Lb_p1 = A_p_p1_g_m2_Lb_p1, A_p_p1_g_0_Lb_m1 = A_p_p1_g_0_Lb_m1, A_p_p1_g_0_Lb_p1 = A_p_p1_g_0_Lb_p1, A_p_p1_g_p2_Lb_m1 = A_p_p1_g_p2_Lb_m1, A_p_p1_g_p2_Lb_p1 = A_p_p1_g_p2_Lb_p1), sigma1, sigma2, sigma3)
