%%%
# Λb0 → p K− γ (LHCb, arXiv:2403.03710)

Kinematics, amplitude model, and observable. All masses are in GeV.
The observable is the unnormalised decay rate in the reference coordinates.
%%%
flatppl_compat = "0.1"

# Kinematics
hep = standard_module("particle-physics", "0.1")
amp = load_module("../../main.flatppl")
kin = load_module("support/kinematics.flatppl")

# ----------------------------------------------------------------------------
# Masses
# ----------------------------------------------------------------------------

m0 = 5.62  % Lb
m1 = 0.938  % p
m2 = 0.493  % K
m3 = 0.0  % g
s0 = m0^2
ms1 = m1^2
ms2 = m2^2
ms3 = m3^2

# ----------------------------------------------------------------------------
# Decay coordinates of the reference topology [[1, 2], 3] and the four-momenta
# ----------------------------------------------------------------------------

# The coordinates of a node are the invariant mass m_<node> of the line and the
# helicity angles cos_theta_<node>, phi_<node> of its first child in its helicity
# frame, as the variables of the JSON file.
cos_theta_12_3 = elementof(interval(-1.0, 1.0))
phi_12_3 = elementof(interval(-pi, pi))
m_12 = elementof(interval(m1 + m2, m0 - m3))
cos_theta_12 = elementof(interval(-1.0, 1.0))
phi_12 = elementof(interval(-pi, pi))

q_12_3 = hep.breakup_momentum(m0, m_12, m3)
e_12_in_12_3 = kin.momentum(q_12_3, cos_theta_12_3, phi_12_3, m_12)
e_3_in_12_3 = kin.opposite(e_12_in_12_3, m3)
q_12 = hep.breakup_momentum(m_12, m1, m2)
e_1_in_12 = kin.momentum(q_12, cos_theta_12, phi_12, m1)
e_2_in_12 = kin.opposite(e_1_in_12, m2)
e1_12 = e_1_in_12
e2_12 = e_2_in_12
e1_12_3 = kin.from_frame(e1_12, e_12_in_12_3, 1.0)
e2_12_3 = kin.from_frame(e2_12, e_12_in_12_3, 1.0)
e3_12_3 = e_3_in_12_3

% Four-momenta in the rest frame of the parent
e1 = e1_12_3
e2 = e2_12_3
e3 = e3_12_3

sigma1_event = amp.mass_squared(e2 + e3)
sigma2_event = amp.mass_squared(e3 + e1)
sigma3_event = amp.mass_squared(e1 + e2)

# Amplitude model
model = load_module("models/lb2pkg-lhcb-2765817.flatppl")

# Observable
intensity_event = model.intensity_of_sigmas(sigma1_event, sigma2_event, sigma3_event)


# ----------------------------------------------------------------------------
# Decay rate, decay distribution and generated events
# ----------------------------------------------------------------------------

% Phase-space density in the decay coordinates: dΦ3 ∝ q p dm dΩ dΩ
phase_space_density = q_12_3 * q_12
rate = phase_space_density * intensity_event
decay_intensity = functionof(intensity_event, cos_theta_12_3, phi_12_3, m_12, cos_theta_12, phi_12)
rate_fn = functionof(rate, cos_theta_12_3, phi_12_3, m_12, cos_theta_12, phi_12)
decay_space = cartprod(cos_theta_12_3 = interval(-1.0, 1.0), phi_12_3 = interval(-pi, pi), m_12 = interval(m1 + m2, m0 - m3), cos_theta_12 = interval(-1.0, 1.0), phi_12 = interval(-pi, pi))
decay_rate = weighted(fn(rate_fn(_)), Lebesgue(support = decay_space))
decay_distribution = normalize(decay_rate)

% Four-momenta in the rest frame of the parent
momenta_fn = functionof(record(p = e1, K = e2, g = e3), cos_theta_12_3, phi_12_3, m_12, cos_theta_12, phi_12)
event_distribution = pushfwd(fn(momenta_fn(_)), decay_distribution)
n_events = 1000
events ~ iid(event_distribution, n_events)

inputs = (cos_theta_12_3, phi_12_3, m_12, cos_theta_12, phi_12)
outputs = rate
