flatppl_compat = "0.1"
a = load_module("../main.flatppl")
x = elementof(interval(-0.75, 0.75))
phase = a.twobody_phasespace(1.0 + x, 0.9, 0.2)
bw = a.resonance_multichannel_breitwigner(
  1.0 + x,
  1.4,
  [0.3, 0.2],
  [0.9, 0.3],
  [0.2, 0.2],
  [0, 1],
  [0.0, 1.5],
)
bugg = a.resonance_bugg_breitwigner(0.8 + x, 0.824, 0.478, 0.23397706275638377, 0.94106)
dm = a.wignerd_matrix(1, x)
dh = a.wignerd_matrix_doublearg(1, x)
p = [2.0, 0.1, 0.2, x]
P = [3.0, 0.2, 0.1, 0.4]
rest = a.boost_to_rest(p, P)
back = a.boost_from_rest(rest, P)
frame = a.helicity_frame(p, P, 2)
angles = a.helicity_angles(p, P, 2)
values = [
  real(phase),
  imag(phase),
  real(bw),
  imag(bw),
  real(bugg),
  imag(bugg),
  dm[1, 2],
  dh[1, 2],
  a.clebschgordan(1, 0, 1, 0, 0, 0),
  a.clebschgordan_doublearg(1, 1, 1, -1, 0, 0),
  a.ls_coupling(3, 1, 2, 2, 1, 1, 0),
  a.mass_squared(p),
  rest[1],
  back[4],
  frame[2],
  angles.costheta,
  angles.phi,
  a.dalitz_cos_theta(1, [2.0, 2.5, 3.04], 2.5, [0.4, 0.5, 0.6]),
  a.dalitz_cos_zeta(1, 1, 2, [2.0, 2.5, 3.04], 2.5, [0.4, 0.5, 0.6]),
]
inputs = x
outputs = values
